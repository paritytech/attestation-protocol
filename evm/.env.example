# BIP39 mnemonic. Used to sign deployments. Defaults to DEV_PHRASE if unset.
export MNEMONIC="bottom drive obey lake curtain smoke basket hold race lonely fit walk"

# Target network, selected by Asset Hub genesis hash (see evm/scripts/network.ts).
export GENESIS_HASH=0xc27c8bf3f13f96dc2130cd2b0a3debe57618fd02521ecc1902bd7dd4ed83d2fe

# DRY_RUN=true prints the addresses the salts resolve to and deploys nothing.
